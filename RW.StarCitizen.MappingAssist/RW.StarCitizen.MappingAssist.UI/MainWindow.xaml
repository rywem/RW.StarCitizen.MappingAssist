<Window x:Class="RW.StarCitizen.MappingAssist.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mapping Assistant" Height="650" Width="1100">
    <Border Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Load / file / status -->
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
                <Button x:Name="BtnLoadMapping"
                        Width="140" Height="32"
                        Click="BtnLoadMapping_Click"
                        Content="Load Mapping…" />
                <TextBlock x:Name="TxtSelectedFile"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Text="No file loaded" />
                <TextBlock x:Name="TxtStatus"
                           Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="Gray"
                           Text="Ready" />
            </StackPanel>

            <!-- Row 1: Device selector -->
            <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,12">
                <TextBlock Text="Input Device:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbDevices"
                          Width="420"
                          ItemsSource="{Binding DeviceChoices}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          SelectionChanged="CmbDevices_SelectionChanged"/>
                <TextBlock Text="Prefix:" Margin="16,0,4,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtPrefix" VerticalAlignment="Center" FontWeight="Bold"/>
                <!-- NEW: button/modifier filter -->
                <TextBlock Text="   Filter:" Margin="16,0,8,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbButtonFilter"
                          Width="260"
                          ItemsSource="{Binding ButtonChoices}"
                          DisplayMemberPath="Display"
                          SelectedItem="{Binding SelectedButtonChoice, Mode=TwoWay}"
                          SelectionChanged="CmbButtonFilter_SelectionChanged"/>
            </DockPanel>

            <!-- Row 2: Main content (Grid with bindings + side image) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="571*"/>
                    <ColumnDefinition Width="157*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Bindings grid -->
                <DataGrid x:Name="BindingsGrid"
                          Grid.Column="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding BindingRows}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectionChanged="BindingsGrid_SelectionChanged" Grid.ColumnSpan="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Action Map" Binding="{Binding ActionMap}" Width="*"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="2*"/>
                        <DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="*"/>

                        <!-- FIXED: Template column must use CellTemplate -->
                        <DataGridTemplateColumn Header="Icon" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding HumanImage}"
                                           Height="24"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Button Name" Binding="{Binding HumanName}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Side panel with image -->
                <Border Grid.Column="2"
                        Margin="12,0,0,0"
                        BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Device Layout" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Image x:Name="DeviceImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Height="280"/>
                        <TextBlock x:Name="ImgCaption"
                                   Margin="0,8,0,0"
                                   Foreground="Gray"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
